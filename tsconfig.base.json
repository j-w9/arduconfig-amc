{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@arduconfig/amc-expr": [
        "./packages/amc-expr/src/index.ts"
      ],
      "@arduconfig/amc-steps": [
        "./packages/amc-steps/src/index.ts"
      ]
    },
    "composite": true,
    "declaration": true
  }
}
